WDK_MNEMONIC=replace-with-runtime-secret
WDK_STORAGE_KEY=replace-with-32-byte-secret
WDK_NETWORK=testnet
WDK_RPC_URL=http://127.0.0.1:8545
WDK_LIGHTNING_PACKAGE=@tetherto/wdk-wallet-spark
